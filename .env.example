# 复制为 .env，只填你有的那几家（填一家就能跑）。.env 已在 .gitignore 里，不会被提交。
# 查看状态：python3 -I tools/image_gen.py --providers

# 多米聚合平台（一个密钥含 Image 2.5 / Nano Banana / Midjourney，实测最完整）
DUOMI_API_KEY=
# DUOMI_MODEL=gpt-image-2.5-sunburst
# DUOMI_BANANA_MODEL=gemini-3.1-flash-image-preview

# OpenAI 官方
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1        # 设成你账号可用的最新图像模型
# OPENAI_BASE_URL=https://api.openai.com/v1

# 任意 OpenAI 兼容中转
COMPAT_API_KEY=
COMPAT_BASE_URL=
# COMPAT_IMAGE_MODEL=gpt-image-1

# Google Gemini API（Nano Banana 2 / Pro）
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview   # Pro：gemini-3-pro-image-preview

# 火山方舟（Seedream）
ARK_API_KEY=
# ARK_IMAGE_MODEL=doubao-seedream-4-0-250828          # 设成控制台已开通的最新 Seedream 版本

# 白模预演：Blender 可执行文件（不设则找 macOS 默认路径和 PATH 里的 blender）
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender

# APIMart 聚合平台（Image 2.5，2K）
APIMART_API_KEY=
